# Copy to .dev.vars for local `wrangler dev` and fill in real values.
# Never commit .dev.vars.
ADMIN_PASSWORD="change-me-long-random-password"
TELEGRAM_BOT_TOKEN="123456789:replace-with-botfather-token"
# Optional Bale token. For production use: npx wrangler secret put BALE_BOT_TOKEN
BALE_BOT_TOKEN=""
# OpenRouter API key (https://openrouter.ai). Server-side only.
# For the deployed Worker use: npx wrangler secret put OPENROUTER_API_KEY
OPENROUTER_API_KEY=""
# Legacy alias from the OpenCode era - still read as a fallback, so a key
# stored under the old name keeps working.
OPENCODE_API_KEY=""
# Phase 4 destination chat: "@channel_username" or "-1001234567890".
# Server-side only; not configurable through the UI or API.
# For the deployed Worker use: npx wrangler secret put TELEGRAM_DESTINATION_CHANNEL
TELEGRAM_DESTINATION_CHANNEL=""
# Optional Bale destination, e.g. @channel or numeric chat id.
BALE_DESTINATION_CHANNEL=""
# Telegram admin numeric User.id (digits only). Never a username.
# Find it via @userinfobot, or read update JSON from the webhook.
# For the deployed Worker use: npx wrangler secret put TELEGRAM_ADMIN_USER_ID
TELEGRAM_ADMIN_USER_ID=""
# Shared secret for the X-Telegram-Bot-Api-Secret-Token header (min 16 chars).
# Generate e.g.: openssl rand -hex 24
# For the deployed Worker use: npx wrangler secret put TELEGRAM_WEBHOOK_SECRET
TELEGRAM_WEBHOOK_SECRET=""
# Optional tuning (plain vars, not secrets). Both are milliseconds.
# Minimum spacing between two OpenRouter chat requests, keeping one run under
# the free tier's account-wide ~20 requests/minute cap. Default 3200.
AI_REQUEST_PACE_MS=""
# Wait between two album card renders, honoring the Browser Run free-tier
# limit of ~1 Quick Action per 10 seconds. Default 10500.
IMAGE_RENDER_SPACING_MS=""
